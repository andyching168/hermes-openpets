{
  "name": "hermes-openpets",
  "version": "0.2.0",
  "description": "A local-only Hermes Desktop plugin that mirrors Hermes agent activity to OpenPets without modifying Hermes itself.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "scripts": {
    "build": "esbuild src/plugin.ts --bundle --format=esm --platform=browser --target=es2022 --external:@hermes/plugin-sdk --external:react --external:react/jsx-runtime --outfile=dist/plugin.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
